{
  "name": "@wits-world/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "db:check": "npm run build && node dist/database/check.js",
    "db:check:test": "npm run build && node dist/database/check.js --test",
    "db:migrate": "npm run build && node dist/database/migrate.js",
    "db:migrate:test": "npm run build && node dist/database/migrate.js --test",
    "db:release": "npm run build && node dist/database/release.js",
    "db:seed": "npm run build && node dist/database/seed.js",
    "db:seed:test": "npm run build && node dist/database/seed.js --test",
    "db:setup": "npm run build && node dist/database/check.js && node dist/database/migrate.js && node dist/database/seed.js",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:database": "RUN_DATABASE_INTEGRATION_TESTS=true vitest run tests/event-database.integration.test.ts tests/player-database.integration.test.ts tests/challenge-persistence.integration.test.ts tests/challenge-attempt-database.integration.test.ts tests/card-catalogue.integration.test.ts tests/deck-persistence.integration.test.ts",
    "type-check": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "jose": "^6.2.8",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.4",
    "tsx": "^4.23.9"
  }
}
