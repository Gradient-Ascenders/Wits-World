{
  "name": "@wits-world/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "db:check": "npm run build && node dist/database/check.js",
    "db:check:test": "npm run build && node dist/database/check.js --test",
    "db:migrate": "npm run build && node dist/database/migrate.js",
    "db:migrate:test": "npm run build && node dist/database/migrate.js --test",
    "db:remap-auth-issuer": "npm run build && node dist/database/remap-auth-issuer.js",
    "db:release": "npm run build && node dist/database/release.js",
    "db:seed": "npm run build && node dist/database/seed.js",
    "db:seed:test": "npm run build && node dist/database/seed.js --test",
    "db:setup": "npm run build && node dist/database/check.js && node dist/database/migrate.js && node dist/database/seed.js",
    "dev": "tsx watch src/server.ts",
    "dev:e2e:sprint1": "tsx e2e/sprint1-server.ts",
    "dev:e2e:basic": "tsc --project tsconfig.e2e.json && node dist-e2e/e2e/basic-server.js",
    "start": "node dist/server.js",
    "lint": "eslint e2e scripts src tests --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:database": "node scripts/run-database-tests.mjs",
    "type-check": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@wits-world/account-policy": "0.0.0",
    "@wits-world/game-rules": "0.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "jose": "^6.2.8",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.9"
  }
}
