# Local development defaults. Add private values to an ignored .env file.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://neondb_owner:replace-with-development-password@example.neon.tech/neondb?sslmode=require&channel_binding=require
TEST_DATABASE_URL=postgresql://neondb_owner:replace-with-test-password@example.neon.tech/neondb_test?sslmode=require&channel_binding=require
# Put the target only in the URL authority/path. Target-override query parameters
# such as host, port, database, dbname, db, hostaddr, or service are rejected.
# Non-secret SHA-256 of the normalized direct target identity
# example.neon.tech:5432/neondb_test. CI pins its approved value in workflow YAML.
TEST_DATABASE_IDENTITY_SHA256=c32ca33bc2dfeb077f7cfda20a50affaa81159376e17b5790e1dfbcb89b20364
# Auth0 access-token validation configuration.
# Canonical issuer: https://dev-5artxfvpdennq8qm.us.auth0.com/
# Production must use the verified custom-domain hostname only after the
# documented player-issuer remap; keep the existing API audience unchanged.
AUTH0_DOMAIN=dev-5artxfvpdennq8qm.us.auth0.com
AUTH0_AUDIENCE=https://api.wits-world.invalid
# Default *.auth0.com tenant hostname. In production this remains the tenant
# domain even when AUTH0_DOMAIN changes to the custom authentication domain.
AUTH0_TENANT_DOMAIN=dev-5artxfvpdennq8qm.us.auth0.com
# Public SPA Client ID used by the API to validate reauthentication ID tokens.
AUTH0_SPA_CLIENT_ID=replace-with-public-spa-client-id
# Browser-to-API CORS configuration.
# Must contain one exact web origin. Wildcards are not permitted.
CORS_ALLOWED_ORIGIN=http://localhost:5173
# Server-only Auth0 Management API M2M credentials.
# Grant this application only the delete:users permission.
AUTH0_MANAGEMENT_CLIENT_ID=replace-with-m2m-client-id
AUTH0_MANAGEMENT_CLIENT_SECRET=replace-with-m2m-client-secret
# Background retry interval for incomplete account deletions. Database-backed
# maintenance defaults to an aligned 30-minute cadence so idle serverless
# Postgres computes can suspend between sweeps.
ACCOUNT_DELETION_RETRY_INTERVAL_MS=1800000
# Server-only HMAC key for viewer-bound asynchronous PvP and ranked standings cursors.
# Generate a random value containing at least 32 UTF-8 bytes.
ASYNC_PVP_CURSOR_SIGNING_KEY=replace-with-at-least-32-random-bytes

# Set a separate random key (at least 32 bytes) to enable offline challenge packs.
# Leave blank for online-only operation. Never use a VITE_ variable for this key.
OFFLINE_PACK_SIGNING_KEY=
# Retain the former key for at least 37 hours during rotation.
OFFLINE_PACK_PREVIOUS_SIGNING_KEY=
# Immediate-on-start and recurring invitation/match deadline sweep interval.
ASYNC_PVP_DEADLINE_SWEEP_INTERVAL_MS=1800000
# Public WebSocket endpoint returned with one-use live PvP tickets. Local
# development may use ws://; deployed environments should use wss://.
LIVE_PVP_WEBSOCKET_URL=ws://127.0.0.1:3000/api/v1/realtime/live
# Frequent database-backed live-turn deadline sweep. Every worker instance may
# run this safely; PostgreSQL locking keeps transitions authoritative.
LIVE_PVP_DEADLINE_SWEEP_INTERVAL_MS=1000
# Idempotent cleanup cadence for the confirmed 24-hour live ticket/access
# retention policy. This schedules purge work; it does not change retention.
LIVE_PVP_TRANSIENT_CLEANUP_INTERVAL_MS=1800000
# Ranked lease, proposal, pairing, and season sweep. Every API instance may run
# this safely; PostgreSQL locks serialize claims and transitions.
RANKED_SWEEP_INTERVAL_MS=1000
# Provisional, configurable 24-hour retention for precise movement evidence.
# Confirm the final policy before production release. The API also enforces a
# technical JavaScript Date limit; this value is not that policy limit.
MOVEMENT_EVIDENCE_RETENTION_MS=86400000
# Idempotent expiry sweep interval for the API worker process. Node timer delays
# must stay between 900000 and 2147483647 milliseconds.
MOVEMENT_EVIDENCE_CLEANUP_INTERVAL_MS=1800000
# Required server-authoritative journey threshold in metres per second. Leave
# unset until the team has reviewed a production value; the API fails startup
# rather than silently inventing one.
MAX_PLAUSIBLE_JOURNEY_SPEED_METRES_PER_SECOND=
# Per-instance protection for successful authenticated API requests. Requests
# are keyed by the server-resolved local player ID, never a browser field or an
# untrusted X-Forwarded-For value.
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000
# Independent per-key fixed-window quota for the external read-only developer API.
DEVELOPER_API_RATE_LIMIT_MAX_REQUESTS=120
DEVELOPER_API_RATE_LIMIT_WINDOW_MS=60000

# Advanced trust score decay/recovery sweep. Operational cadence only; not a trust-v1 policy value.
TRUST_EVALUATION_INTERVAL_MS=1800000
CARD_TRADE_MAINTENANCE_INTERVAL_MS=1800000
