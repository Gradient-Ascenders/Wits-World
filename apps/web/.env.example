# Public browser configuration only. Never place secrets in VITE_ variables.
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Required Auth0 Single Page Application configuration, validated at startup.
# These values are public. Local development uses the development tenant below.
# Production must replace the domain with the verified same-site custom domain.
VITE_AUTH0_DOMAIN=dev-5artxfvpdennq8qm.us.auth0.com
VITE_AUTH0_CLIENT_ID=replace-with-public-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.wits-world.invalid
# Optional Auth0 database connection name for password-reset emails.
# Omit when using Auth0's default Username-Password-Authentication connection.
VITE_AUTH0_DATABASE_CONNECTION=Username-Password-Authentication
# Intentionally public browser token. Use only styles:read/fonts:read and
# restrict the token to the approved local and deployed web origins.
VITE_MAPBOX_ACCESS_TOKEN=replace-with-public-mapbox-access-token
# Optional development-only location override. Set all three values in ignored
# .env.local to bypass browser geolocation while running `npm run dev`.
VITE_DEV_GEO_LAT=
VITE_DEV_GEO_LNG=
VITE_DEV_GEO_ACCURACY=
