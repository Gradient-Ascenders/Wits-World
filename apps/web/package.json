{
  "name": "@wits-world/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:account-policy": "npm run build --workspace @wits-world/account-policy",
    "prebuild": "npm run prepare:account-policy",
    "build": "tsc --project tsconfig.json --noEmit && vite build",
    "prebuild:bundle": "npm run prepare:account-policy",
    "build:bundle": "vite build",
    "predev": "npm run prepare:account-policy",
    "dev": "vite",
    "lint": "eslint src tests playwright server.mjs server.test.mjs playwright.config.ts playwright.battle.config.ts playwright.sprint1.config.ts playwright.starter.config.ts --max-warnings=0",
    "preview": "vite preview",
    "pretest": "npm run prepare:account-policy",
    "test": "vitest run && node --test server.test.mjs",
    "pretest:coverage": "npm run prepare:account-policy",
    "test:coverage": "vitest run --coverage && node --test server.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:sprint1:playwright": "playwright test --config=playwright.sprint1.config.ts",
    "test:e2e:basic:playwright": "playwright test --config=playwright.basic.config.ts",
    "test:e2e:starter": "playwright test --config=playwright.starter.config.ts",
    "test:e2e:trails": "playwright test --config=playwright/trails.config.ts",
    "test:e2e:battle": "playwright test --config=playwright.battle.config.ts",
    "test:e2e:progression": "playwright test --config=playwright/progression.config.ts",
    "test:e2e:offline": "playwright test --config=playwright/offline.config.ts",
    "test:e2e:experience-regressions": "playwright test --config=playwright/explore.config.ts && playwright test --config=playwright/account.config.ts",
    "pretest:e2e:offline": "npm run prepare:account-policy",
    "test:e2e:auth": "playwright test --project=auth-setup",
    "test:e2e:headed": "playwright test --headed",
    "pretype-check": "npm run prepare:account-policy",
    "type-check": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.playwright.json --noEmit"
  },
  "dependencies": {
    "@auth0/auth0-react": "2.23.0",
    "@phosphor-icons/react": "^2.1.10",
    "@wits-world/account-policy": "0.0.0",
    "idb": "8.0.3",
    "mapbox-gl": "3.28.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "wouter": "3.10.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "dotenv": "^17.4.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0"
  }
}
