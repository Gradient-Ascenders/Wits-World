{
  "name": "wits-world",
  "version": "0.0.0",
  "private": true,
  "description": "Wits World project monorepo for the Wits Quest game",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.14.1 <25",
    "npm": ">=11.18.0 <12"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "view": "npm run dev --workspace @wits-world/web",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
