+      const monthly = await service.listLeaderboard({
+        period: 'monthly',
+        month: '2026-09',
+        page: 1,
+        pageSize: 20,
+      });
+      expect(monthly.entries).toContainEqual(
+        expect.objectContaining({ playerName: 'dev_public', points: 0 }),
