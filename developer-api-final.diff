diff --git a/apps/api/tests/developer-api-key-service.test.ts b/apps/api/tests/developer-api-key-service.test.ts
new file mode 100644
index 0000000..6e2dbe5
--- /dev/null
+++ b/apps/api/tests/developer-api-key-service.test.ts
@@ -0,0 +1,114 @@
+import type pg from 'pg';
+import { describe, expect, it, vi } from 'vitest';
+
+import {
+  createDeveloperApiKeyService,
+  parseDeveloperApiKey,
+  type DeveloperApiKeyDatabase,
+} from '../src/developer/developer-api-key-service.js';
+
+const PLAYER_ID = '17200000-0000-4000-8000-000000000001';
+const KEY_ID = '18200000-0000-4000-8000-000000000001';
+
+describe('developer API key service', () => {
+  it('generates a high-entropy one-time credential and persists only its hash', async () => {
+    let persistedHash: Buffer | undefined;
+    let persistedPublicId = '';
+    const now = new Date('2026-09-23T18:00:00.000Z');
+
+    const client = {
+      query: vi.fn(async (statement: string, values?: unknown[]) => {
+        if (
+          statement === 'begin' ||
+          statement === 'commit' ||
+          statement === 'rollback'
+        ) {
+          return { rows: [] };
+        }
+        if (statement.includes('from public.players')) {
+          return { rows: [{ id: PLAYER_ID }] };
+        }
+        if (statement.includes('count(*)::integer')) {
+          return { rows: [{ count: 0 }] };
+        }
+        if (statement.includes('insert into private.developer_api_keys')) {
+          persistedPublicId = String(values?.[2]);
+          persistedHash = values?.[3] as Buffer;
+          return {
+            rows: [
+              {
+                id: KEY_ID,
+                name: values?.[1],
+                public_id: persistedPublicId,
+                created_at: now,
+                last_used_at: null,
+                revoked_at: null,
+              },
+            ],
+          };
+        }
+        throw new Error(`Unexpected transaction query: ${statement}`);
+      }),
+      release: vi.fn(),
+    } as unknown as pg.PoolClient;
+
+    const database: DeveloperApiKeyDatabase = {
+      connect: vi.fn().mockResolvedValue(client),
+      query: vi.fn(async (statement: string, values?: unknown[]) => {
+        if (statement.includes('key.secret_hash')) {
+          return {
+            rows: [
+              {
+                id: KEY_ID,
+                owner_player_id: PLAYER_ID,
+                secret_hash: persistedHash!,
+              },
+            ],
+          };
+        }
+        if (statement.startsWith('update private.developer_api_keys')) {
+          return { rows: [] };
+        }
+        throw new Error(
+          `Unexpected pool query: ${statement} ${String(values)}`,
+        );
+      }) as unknown as DeveloperApiKeyDatabase['query'],
+    };
+
+    const service = createDeveloperApiKeyService(database);
+    const created = await service.createForPlayer(PLAYER_ID, ' Lecturer demo ');
+
+    expect(created.apiKey).toMatch(/^ww_api_[a-f0-9]{16}_[A-Za-z0-9_-]{43}$/u);
+    expect(created.key).toMatchObject({
+      id: KEY_ID,
+      name: 'Lecturer demo',
+      keyPrefix: `ww_api_${persistedPublicId}_…`,
+      status: 'active',
+    });
+    expect(persistedHash).toBeInstanceOf(Buffer);
+    expect(persistedHash).toHaveLength(32);
+    expect(persistedHash?.toString('utf8')).not.toContain(created.apiKey);
+
+    await expect(service.authenticate(created.apiKey)).resolves.toEqual({
+      id: KEY_ID,
+      ownerPlayerId: PLAYER_ID,
+    });
+
+    const wrongSecret = `${created.apiKey.slice(0, -1)}${
+      created.apiKey.endsWith('A') ? 'B' : 'A'
+    }`;
+    await expect(service.authenticate(wrongSecret)).resolves.toBeNull();
+  });
+
+  it('rejects malformed developer credentials before querying the database', async () => {
+    const database: DeveloperApiKeyDatabase = {
+      connect: vi.fn(),
+      query: vi.fn(),
+    };
+    const service = createDeveloperApiKeyService(database);
+
+    await expect(service.authenticate('not-an-api-key')).resolves.toBeNull();
+    expect(database.query).not.toHaveBeenCalled();
+    expect(parseDeveloperApiKey('not-an-api-key')).toBeNull();
+  });
+});
diff --git a/apps/api/tests/developer-api-logging.test.ts b/apps/api/tests/developer-api-logging.test.ts
new file mode 100644
index 0000000..66c0ef8
--- /dev/null
+++ b/apps/api/tests/developer-api-logging.test.ts
@@ -0,0 +1,92 @@
+import type { FastifyInstance } from 'fastify';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { buildApp } from '../src/app.js';
+import type { AuthConfig } from '../src/config/auth.js';
+import type { DeveloperApiKeyService } from '../src/developer/developer-api-key-service.js';
+import type { DeveloperPublicDataService } from '../src/developer/developer-public-data-service.js';
+import { createRateProtection } from '../src/security/rate-protection.js';
+
+const authConfig: AuthConfig = {
+  domain: 'auth.example.test',
+  issuer: 'https://auth.example.test/',
+  audience: 'https://api.example.test',
+  spaClientId: 'wits-world-spa-client',
+  jwksUrl: new URL('https://auth.example.test/.well-known/jwks.json'),
+};
+
+const API_KEY = `ww_api_0123456789abcdef_${'a'.repeat(43)}`;
+
+describe('developer API credential log redaction', () => {
+  let app: FastifyInstance;
+  let output = '';
+
+  beforeEach(async () => {
+    output = '';
+    const keyService: DeveloperApiKeyService = {
+      listForPlayer: vi.fn(),
+      createForPlayer: vi.fn(),
+      revokeForPlayer: vi.fn(),
+      authenticate: vi.fn().mockResolvedValue({
+        id: '18200000-0000-4000-8000-000000000001',
+        ownerPlayerId: '17200000-0000-4000-8000-000000000001',
+      }),
+    };
+    const publicDataService: DeveloperPublicDataService = {
+      listEvents: vi.fn(),
+      getEvent: vi.fn(),
+      listCards: vi.fn(),
+      getCard: vi.fn(),
+      listLeaderboard: vi.fn(),
+    };
+
+    app = await buildApp({
+      authConfig,
+      accessTokenVerifier: { verify: vi.fn() },
+      logger: true,
+      logDestination: {
+        write(message) {
+          output += message;
+        },
+      },
+      playerIdentityService: { resolve: vi.fn() },
+      developerApi: {
+        keyService,
+        publicDataService,
+        rateProtection: createRateProtection({
+          maxRequests: 120,
+          windowMs: 60_000,
+        }),
+      },
+    });
+
+    app.get(
+      '/developer-redaction-probe',
+      { onRequest: [app.authenticateDeveloperApiKey] },
+      async (request) => {
+        request.log.info(
+          { headers: request.headers },
+          'Developer API redaction regression probe',
+        );
+        return { ok: true };
+      },
+    );
+  });
+
+  afterEach(async () => {
+    await app.close();
+  });
+
+  it('redacts the X-API-Key header from structured logs', async () => {
+    const response = await app.inject({
+      method: 'GET',
+      url: '/developer-redaction-probe',
+      headers: { 'x-api-key': API_KEY },
+    });
+
+    expect(response.statusCode).toBe(200);
+    expect(output).toContain('Developer API redaction regression probe');
+    expect(output).toContain('[REDACTED]');
+    expect(output).not.toContain(API_KEY);
+  });
+});
diff --git a/apps/api/tests/developer-api-persistence.integration.test.ts b/apps/api/tests/developer-api-persistence.integration.test.ts
new file mode 100644
index 0000000..f4a4b10
--- /dev/null
+++ b/apps/api/tests/developer-api-persistence.integration.test.ts
@@ -0,0 +1,220 @@
+import { randomUUID } from 'node:crypto';
+
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+
+import {
+  buildDatabaseConfig,
+  loadApiEnvironment,
+  type DatabaseConfig,
+} from '../src/config/database.js';
+import {
+  createDatabasePool,
+  withDatabaseClient,
+} from '../src/database/connection.js';
+import { runMigrations } from '../src/database/migrations.js';
+import { createDeveloperApiKeyService } from '../src/developer/developer-api-key-service.js';
+import { createDeveloperPublicDataService } from '../src/developer/developer-public-data-service.js';
+import { createAccountDeletionLifecycle } from '../src/players/account-deletion-lifecycle.js';
+
+const runIntegrationTests =
+  process.env.RUN_DATABASE_INTEGRATION_TESTS === 'true';
+const ISSUER = 'https://auth.example.test/';
+
+describe.skipIf(!runIntegrationTests)(
+  'developer API persistence integration',
+  () => {
+    let administrationConfig: DatabaseConfig;
+    let temporaryConfig: DatabaseConfig;
+    let temporaryDatabaseName: string;
+    let pool: ReturnType<typeof createDatabasePool>;
+
+    beforeAll(async () => {
+      loadApiEnvironment();
+      administrationConfig = buildDatabaseConfig({ target: 'test' });
+      temporaryDatabaseName = `wits_quest_developer_api_${Date.now()}_${process.pid}`;
+
+      await withDatabaseClient(administrationConfig, async (client) => {
+        await client.query(`create database ${temporaryDatabaseName}`);
+      });
+
+      const url = new URL(administrationConfig.connectionString);
+      url.pathname = `/${temporaryDatabaseName}`;
+      temporaryConfig = {
+        ...administrationConfig,
+        connectionString: url.toString(),
+      };
+
+      const migrationResult = await runMigrations(temporaryConfig);
+      expect(migrationResult.applied).toContain(
+        '0058_create_developer_api_access.sql',
+      );
+      pool = createDatabasePool(temporaryConfig);
+    }, 120_000);
+
+    afterAll(async () => {
+      if (pool) await pool.end();
+      if (!administrationConfig || !temporaryDatabaseName) return;
+      await withDatabaseClient(administrationConfig, async (client) => {
+        await client.query(
+          `drop database if exists ${temporaryDatabaseName} with (force)`,
+        );
+      });
+    }, 30_000);
+
+    it('keeps hashed credentials private and enforces the five-active-key limit under concurrency', async () => {
+      const playerId = randomUUID();
+      await insertPlayer(playerId, 'dev_limit');
+      const service = createDeveloperApiKeyService(pool);
+
+      const results = await Promise.allSettled(
+        Array.from({ length: 6 }, (_, index) =>
+          service.createForPlayer(playerId, `Application ${index + 1}`),
+        ),
+      );
+
+      expect(
+        results.filter((result) => result.status === 'fulfilled'),
+      ).toHaveLength(5);
+      expect(
+        results.filter((result) => result.status === 'rejected'),
+      ).toHaveLength(1);
+
+      const stored = await pool.query<{
