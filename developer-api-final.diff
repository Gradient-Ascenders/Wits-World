diff --git a/apps/web/src/api/developer.ts b/apps/web/src/api/developer.ts
new file mode 100644
index 0000000..9e9bdac
--- /dev/null
+++ b/apps/web/src/api/developer.ts
@@ -0,0 +1,228 @@
+import type { ApiAccessTokenProvider } from '../auth/useApiAccessToken';
+
+export type DeveloperApiKeyStatus = 'active' | 'revoked';
+
+export interface DeveloperApiKeyMetadata {
+  id: string;
+  name: string;
+  keyPrefix: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+  revokedAt: string | null;
+  status: DeveloperApiKeyStatus;
+}
+
+export interface DeveloperApiKeyList {
+  keys: DeveloperApiKeyMetadata[];
+  activeKeyLimit: number;
+}
+
+export interface CreatedDeveloperApiKey {
+  key: DeveloperApiKeyMetadata;
+  apiKey: string;
+}
+
+export type DeveloperApiFailure =
+  'authorization' | 'key-limit' | 'not-found' | 'unavailable';
+
+export class DeveloperApiError extends Error {
+  constructor(
+    public readonly failure: DeveloperApiFailure,
+    public readonly requestId?: string,
+  ) {
+    super('The developer API request could not be completed.');
+    this.name = 'DeveloperApiError';
+  }
+}
+
+interface RequestOptions {
+  apiBaseUrl: string;
+  getAccessToken: ApiAccessTokenProvider;
+  signal: AbortSignal;
+}
+
+export async function listDeveloperApiKeys(
+  options: RequestOptions,
+): Promise<DeveloperApiKeyList> {
+  const payload = await requestJson(`${options.apiBaseUrl}/developer/keys`, {
+    ...options,
+    method: 'GET',
+  });
+  if (
+    !isRecord(payload) ||
+    !hasExactKeys(payload, ['activeKeyLimit', 'keys', 'requestId']) ||
+    !Number.isInteger(payload.activeKeyLimit) ||
+    Number(payload.activeKeyLimit) < 1 ||
+    !Array.isArray(payload.keys) ||
+    typeof payload.requestId !== 'string'
+  ) {
+    throw new DeveloperApiError('unavailable');
+  }
+  return {
+    activeKeyLimit: Number(payload.activeKeyLimit),
+    keys: payload.keys.map(parseKeyMetadata),
+  };
+}
+
+export async function createDeveloperApiKey(
+  options: RequestOptions & { name: string },
+): Promise<CreatedDeveloperApiKey> {
+  const payload = await requestJson(`${options.apiBaseUrl}/developer/keys`, {
+    ...options,
+    method: 'POST',
+    body: { name: options.name },
+  });
+  if (
+    !isRecord(payload) ||
+    !hasExactKeys(payload, ['apiKey', 'key', 'requestId']) ||
+    typeof payload.apiKey !== 'string' ||
+    !payload.apiKey.startsWith('ww_api_') ||
+    typeof payload.requestId !== 'string'
+  ) {
+    throw new DeveloperApiError('unavailable');
+  }
+  return { apiKey: payload.apiKey, key: parseKeyMetadata(payload.key) };
+}
+
+export async function revokeDeveloperApiKey(
+  options: RequestOptions & { keyId: string },
+): Promise<DeveloperApiKeyMetadata> {
+  const payload = await requestJson(
+    `${options.apiBaseUrl}/developer/keys/${encodeURIComponent(options.keyId)}`,
+    { ...options, method: 'DELETE' },
+  );
+  if (
+    !isRecord(payload) ||
+    !hasExactKeys(payload, ['key', 'requestId']) ||
+    typeof payload.requestId !== 'string'
+  ) {
+    throw new DeveloperApiError('unavailable');
+  }
+  return parseKeyMetadata(payload.key);
+}
+
+async function requestJson(
+  url: string,
+  options: RequestOptions & {
+    method: 'GET' | 'POST' | 'DELETE';
+    body?: Record<string, unknown>;
+  },
+): Promise<unknown> {
+  let accessToken: string;
+  try {
+    accessToken = await options.getAccessToken();
+  } catch {
+    throw new DeveloperApiError('authorization');
+  }
+
+  let response: Response;
+  try {
+    response = await fetch(url, {
+      method: options.method,
+      headers: {
+        Accept: 'application/json',
+        Authorization: `Bearer ${accessToken}`,
+        ...(options.body ? { 'Content-Type': 'application/json' } : {}),
+      },
+      ...(options.body ? { body: JSON.stringify(options.body) } : {}),
+      signal: options.signal,
+    });
+  } catch (error) {
+    if (options.signal.aborted) throw error;
+    throw new DeveloperApiError('unavailable');
+  }
+
+  if (!response.ok) {
+    const problem = await readProblem(response);
+    const requestId =
+      typeof problem?.requestId === 'string' ? problem.requestId : undefined;
+    if (response.status === 401 || response.status === 403) {
+      throw new DeveloperApiError('authorization', requestId);
+    }
+    if (
+      response.status === 409 &&
+      problem?.code === 'DEVELOPER_API_KEY_LIMIT_REACHED'
+    ) {
+      throw new DeveloperApiError('key-limit', requestId);
+    }
+    if (response.status === 404) {
+      throw new DeveloperApiError('not-found', requestId);
+    }
+    throw new DeveloperApiError('unavailable', requestId);
+  }
+
+  return response.json().catch(() => {
+    throw new DeveloperApiError('unavailable');
+  });
+}
+
+function parseKeyMetadata(value: unknown): DeveloperApiKeyMetadata {
+  if (
+    !isRecord(value) ||
+    !hasExactKeys(value, [
+      'createdAt',
+      'id',
+      'keyPrefix',
+      'lastUsedAt',
+      'name',
+      'revokedAt',
+      'status',
+    ]) ||
+    !isUuid(value.id) ||
+    typeof value.name !== 'string' ||
+    typeof value.keyPrefix !== 'string' ||
+    typeof value.createdAt !== 'string' ||
+    !isNullableString(value.lastUsedAt) ||
+    !isNullableString(value.revokedAt) ||
+    (value.status !== 'active' && value.status !== 'revoked')
+  ) {
+    throw new DeveloperApiError('unavailable');
+  }
+  return {
+    id: value.id,
+    name: value.name,
+    keyPrefix: value.keyPrefix,
+    createdAt: value.createdAt,
+    lastUsedAt: value.lastUsedAt,
+    revokedAt: value.revokedAt,
+    status: value.status,
+  };
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null;
+}
+
+function hasExactKeys(
+  value: Record<string, unknown>,
+  keys: readonly string[],
+): boolean {
+  const actual = Object.keys(value).sort();
+  const expected = [...keys].sort();
+  return (
+    actual.length === expected.length &&
+    actual.every((key, index) => key === expected[index])
+  );
+}
+
+function isUuid(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    /^[\da-f]{8}(?:-[\da-f]{4}){3}-[\da-f]{12}$/iu.test(value)
+  );
+}
+
+function isNullableString(value: unknown): value is string | null {
+  return value === null || typeof value === 'string';
+}
+
+async function readProblem(
+  response: Response,
+): Promise<Record<string, unknown> | null> {
+  try {
+    const payload: unknown = await response.json();
+    return isRecord(payload) ? payload : null;
+  } catch {
+    return null;
+  }
+}
diff --git a/apps/web/src/components/account/DeveloperApiAccess.tsx b/apps/web/src/components/account/DeveloperApiAccess.tsx
new file mode 100644
index 0000000..87b7065
--- /dev/null
+++ b/apps/web/src/components/account/DeveloperApiAccess.tsx
@@ -0,0 +1,398 @@
+import { useEffect, useRef, useState } from 'react';
+
+import {
+  createDeveloperApiKey,
+  DeveloperApiError,
+  listDeveloperApiKeys,
+  revokeDeveloperApiKey,
+  type DeveloperApiKeyList,
+} from '../../api/developer';
+import type { ApiAccessTokenProvider } from '../../auth/useApiAccessToken';
+
+interface DeveloperApiAccessProps {
+  apiBaseUrl: string;
+  getAccessToken: ApiAccessTokenProvider;
+}
+
+type LoadState =
+  | { status: 'loading' }
+  | { status: 'ready'; data: DeveloperApiKeyList }
+  | { status: 'error'; error: DeveloperApiError };
+
+export function DeveloperApiAccess({
+  apiBaseUrl,
+  getAccessToken,
+}: DeveloperApiAccessProps) {
+  const [state, setState] = useState<LoadState>({ status: 'loading' });
+  const [name, setName] = useState('');
+  const [creating, setCreating] = useState(false);
+  const [createdSecret, setCreatedSecret] = useState<string | null>(null);
+  const [copyState, setCopyState] = useState<'idle' | 'copied' | 'failed'>(
+    'idle',
+  );
+  const [revokingId, setRevokingId] = useState<string | null>(null);
+  const [mutationError, setMutationError] = useState<DeveloperApiError | null>(
+    null,
+  );
+  const secretHeading = useRef<HTMLHeadingElement>(null);
+  const revokeTrigger = useRef<HTMLButtonElement | null>(null);
+
+  useEffect(() => {
+    const controller = new AbortController();
+    setState({ status: 'loading' });
+    void listDeveloperApiKeys({
+      apiBaseUrl,
+      getAccessToken,
+      signal: controller.signal,
+    })
+      .then((data) => {
+        if (!controller.signal.aborted) setState({ status: 'ready', data });
+      })
+      .catch((error) => {
+        if (!controller.signal.aborted) {
+          setState({
+            status: 'error',
+            error:
+              error instanceof DeveloperApiError
+                ? error
+                : new DeveloperApiError('unavailable'),
+          });
+        }
+      });
+    return () => controller.abort();
+  }, [apiBaseUrl, getAccessToken]);
+
+  useEffect(() => {
+    if (createdSecret) secretHeading.current?.focus();
+  }, [createdSecret]);
+
+  async function refresh() {
+    const controller = new AbortController();
+    try {
+      const data = await listDeveloperApiKeys({
+        apiBaseUrl,
+        getAccessToken,
+        signal: controller.signal,
+      });
+      setState({ status: 'ready', data });
+    } catch (error) {
+      setState({
+        status: 'error',
+        error:
+          error instanceof DeveloperApiError
+            ? error
+            : new DeveloperApiError('unavailable'),
+      });
+    }
+  }
+
+  async function createKey() {
+    const trimmedName = name.trim();
+    if (!trimmedName || creating) return;
+    setCreating(true);
+    setMutationError(null);
+    setCreatedSecret(null);
+    setCopyState('idle');
+    const controller = new AbortController();
+    try {
+      const created = await createDeveloperApiKey({
+        apiBaseUrl,
+        getAccessToken,
+        name: trimmedName,
+        signal: controller.signal,
+      });
+      setName('');
+      setCreatedSecret(created.apiKey);
+      await refresh();
+    } catch (error) {
+      setMutationError(
+        error instanceof DeveloperApiError
+          ? error
+          : new DeveloperApiError('unavailable'),
+      );
+    } finally {
+      setCreating(false);
+    }
+  }
+
+  async function revokeKey(keyId: string) {
+    setMutationError(null);
+    const controller = new AbortController();
+    try {
+      await revokeDeveloperApiKey({
+        apiBaseUrl,
+        getAccessToken,
+        keyId,
+        signal: controller.signal,
+      });
+      setRevokingId(null);
+      await refresh();
+    } catch (error) {
+      setMutationError(
+        error instanceof DeveloperApiError
+          ? error
+          : new DeveloperApiError('unavailable'),
+      );
+    }
+  }
+
+  async function copySecret() {
+    if (!createdSecret) return;
+    try {
+      await navigator.clipboard.writeText(createdSecret);
+      setCopyState('copied');
+    } catch {
+      setCopyState('failed');
+    }
+  }
+
+  const activeCount =
+    state.status === 'ready'
+      ? state.data.keys.filter((key) => key.status === 'active').length
+      : 0;
+  const atLimit =
+    state.status === 'ready' && activeCount >= state.data.activeKeyLimit;
+  const hasUnacknowledgedSecret = createdSecret !== null;
+
+  return (
+    <section
+      aria-labelledby="developer-api-access-title"
+      className="account-page__section"
+    >
+      <div className="account-section-heading">
+        <h2 id="developer-api-access-title">Developer API access</h2>
+        <p>
+          Create credentials for HTTP tools and server-side applications that
+          read published events, the card catalogue and public leaderboard.
+        </p>
+      </div>
+
+      <div className="developer-api-card">
+        {createdSecret ? (
+          <div className="developer-api-secret" role="region">
+            <h3 ref={secretHeading} tabIndex={-1}>
+              Save this API key now
+            </h3>
+            <p>
+              Wits World cannot show the complete value again. Keep it out of
+              source control, URLs and browser bundles.
+            </p>
+            <input
+              aria-label="Generated API key"
+              autoComplete="off"
+              className="developer-api-secret__value"
+              onFocus={(event) => event.currentTarget.select()}
+              readOnly
+              spellCheck={false}
+              type="text"
+              value={createdSecret}
+            />
+            <div className="developer-api-secret__actions">
+              <button
+                className="button"
+                onClick={() => void copySecret()}
+                type="button"
+              >
+                Copy API key
+              </button>
+              <button
+                className="button button--quiet"
+                onClick={() => {
+                  setCreatedSecret(null);
+                  setCopyState('idle');
+                }}
+                type="button"
+              >
+                I have saved it
+              </button>
+            </div>
+            {copyState === 'copied' ? (
+              <p
+                aria-live="polite"
+                className="account-inline-status"
+                role="status"
+              >
+                API key copied.
+              </p>
+            ) : null}
+            {copyState === 'failed' ? (
+              <p className="account-inline-error" role="alert">
+                Copying failed. Select the key above and copy it manually before
+                closing this message.
+              </p>
+            ) : null}
+          </div>
+        ) : null}
+
+        <form
+          className="developer-api-form"
+          onSubmit={(event) => {
+            event.preventDefault();
+            void createKey();
+          }}
+        >
+          <label htmlFor="developer-api-key-name">Key name</label>
+          <div className="developer-api-form__controls">
+            <input
+              autoComplete="off"
+              disabled={creating || atLimit || hasUnacknowledgedSecret}
+              id="developer-api-key-name"
+              maxLength={80}
+              onChange={(event) => setName(event.target.value)}
+              placeholder="My Discord bot"
+              required
+              type="text"
+              value={name}
+            />
+            <button
+              className="button"
+              disabled={
+                creating || atLimit || hasUnacknowledgedSecret || !name.trim()
+              }
+              type="submit"
+            >
+              {creating ? 'Generating…' : 'Generate API key'}
+            </button>
+          </div>
+          {atLimit ? (
+            <p className="account-inline-status">
+              You have reached the{' '}
+              {state.status === 'ready' ? state.data.activeKeyLimit : 5}-key
+              active limit. Revoke a key before generating another.
+            </p>
+          ) : null}
+        </form>
+
+        {mutationError ? (
+          <DeveloperApiErrorMessage error={mutationError} />
+        ) : null}
+
+        {state.status === 'loading' ? (
+          <p aria-live="polite" className="account-inline-status" role="status">
+            Loading developer API keys…
+          </p>
+        ) : null}
+
+        {state.status === 'error' ? (
+          <div className="developer-api-error">
+            <DeveloperApiErrorMessage error={state.error} />
+            <button
+              className="button button--quiet"
+              onClick={() => void refresh()}
+              type="button"
+            >
+              Try again
+            </button>
+          </div>
+        ) : null}
+
+        {state.status === 'ready' ? (
+          <div className="developer-api-keys">
+            <div className="developer-api-keys__heading">
+              <h3>Your API keys</h3>
+              <p>
+                {activeCount} of {state.data.activeKeyLimit} active
+              </p>
+            </div>
+            {state.data.keys.length === 0 ? (
+              <p className="developer-api-empty">
+                No developer API keys yet. Generate one when you are ready to
+                connect an external application.
+              </p>
+            ) : (
+              <ul>
+                {state.data.keys.map((key) => (
+                  <li key={key.id}>
+                    <div className="developer-api-key-row__summary">
+                      <strong>{key.name}</strong>
+                      <code>{key.keyPrefix}</code>
+                      <span>
+                        Created {formatDate(key.createdAt)} · Last used{' '}
+                        {key.lastUsedAt ? formatDate(key.lastUsedAt) : 'never'}
+                      </span>
+                      <span
+                        className={`developer-api-key-status developer-api-key-status--${key.status}`}
+                      >
+                        {key.status === 'active' ? 'Active' : 'Revoked'}
+                      </span>
+                    </div>
+                    {key.status === 'active' ? (
+                      <>
+                        <button
+                          aria-controls={`developer-api-revoke-${key.id}`}
+                          aria-expanded={revokingId === key.id}
+                          className="button button--quiet"
+                          onClick={(event) => {
+                            revokeTrigger.current = event.currentTarget;
+                            setRevokingId(key.id);
+                          }}
+                          type="button"
+                        >
+                          Revoke
+                        </button>
+                        {revokingId === key.id ? (
+                          <div
+                            className="developer-api-revoke-confirmation"
+                            id={`developer-api-revoke-${key.id}`}
+                          >
+                            <p>
+                              Revoke this key? Applications using it will stop
+                              working immediately.
+                            </p>
+                            <div>
+                              <button
+                                className="button button--danger"
+                                onClick={() => void revokeKey(key.id)}
+                                type="button"
+                              >
+                                Revoke key
+                              </button>
+                              <button
+                                className="button button--quiet"
+                                onClick={() => {
+                                  setRevokingId(null);
+                                  revokeTrigger.current?.focus();
+                                }}
+                                type="button"
+                              >
+                                Cancel
+                              </button>
+                            </div>
+                          </div>
+                        ) : null}
+                      </>
+                    ) : null}
+                  </li>
+                ))}
+              </ul>
+            )}
+          </div>
+        ) : null}
+      </div>
+    </section>
+  );
+}
+
+function DeveloperApiErrorMessage({ error }: { error: DeveloperApiError }) {
+  const message =
+    error.failure === 'authorization'
+      ? 'Your session cannot manage developer API keys. Sign in again and retry.'
+      : error.failure === 'key-limit'
+        ? 'The active key limit was reached. Revoke an existing key and try again.'
+        : error.failure === 'not-found'
+          ? 'That API key is no longer available. Refresh the list and try again.'
+          : 'Developer API access is temporarily unavailable. Try again.';
+  return (
+    <p className="account-inline-error" role="alert">
+      {message}
+      {error.requestId ? ` Support reference: ${error.requestId}` : ''}
+    </p>
+  );
+}
+
+function formatDate(value: string): string {
+  const date = new Date(value);
+  return Number.isNaN(date.getTime())
+    ? value
+    : new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' }).format(date);
+}
