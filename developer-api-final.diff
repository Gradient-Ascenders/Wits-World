+  month?: string;
+  page?: number;
+  pageSize?: number;
+}
+
+const apiErrorSchema = {
+  type: 'object',
+  additionalProperties: false,
+  required: ['type', 'title', 'status', 'code', 'detail', 'requestId'],
+  properties: {
+    type: { type: 'string' },
