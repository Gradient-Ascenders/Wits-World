+  });
+});
+
+afterEach(async () => {
+  await app.close();
+});
+
+describe('developer API', () => {
+  it('requires X-API-Key and keeps bearer authentication separate', async () => {
+    const missing = await app.inject({
+      method: 'GET',
+      url: '/api/v1/developer/cards',
